sdk-cancel = إلغاء
sdk-clear = مسح
sdk-first = الأولى
sdk-previous = السابق
sdk-next = التالي
sdk-last = الأخيرة
sdk-no-matches = لا توجد نتائج
sdk-select-placeholder = اختر…
sdk-search-placeholder = بحث…
sdk-selection-search = البحث في الخيارات
sdk-page-of = الصفحة { $page } من { $pages }
sdk-rows-per-page = صفوف في الصفحة
sdk-selection-summary = الصفوف المحددة: { $selected } من { $total }

sdk-no-selection = لا شيء
sdk-autocomplete-status = الحالة: { $status ->
    [idle] جاهز
    [searching] جارٍ البحث
    [complete] مكتمل
   *[other] لا توجد نتيجة
}
sdk-autocomplete-detail = المحدد: { $selected } | النتائج: { $matches } | الأخير: { $last } | لوحة المفاتيح: { $keyboard }

sdk-disabled = معطّل
sdk-selection-mode = وضع الاختيار: { $mode ->
    [none] بدون اختيار
    [single-required] اختيار واحد مطلوب
    [single-optional] اختيار واحد اختياري
    [multiple] اختيار متعدد
   *[extended] اختيار موسّع
}
