        hover_background        = hsla(87.92, 0.75, 0.64, 1)
        active_background       = hsla(225.43, 0.9, 0.38, 1)
        close_hover_background  = hsla(2.94, 0.75, 0.52, 1)
        close_active_background = hsla(140.45, 0.9, 0.64, 1)
        close_foreground        = hsla(277.96, 0.75, 0.38, 1)
      }
      surface {
        panel {
