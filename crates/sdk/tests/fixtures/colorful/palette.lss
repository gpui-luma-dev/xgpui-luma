          border     = hsla(330.48, 0.9, 0.38, 1)
        }
        floating {
          background = hsla(107.99, 0.75, 0.52, 1)
          foreground = hsla(245.5, 0.9, 0.64, 1)
          border     = hsla(23.0, 0.75, 0.38, 1)
        }
        subtle {
          background = hsla(160.51, 0.9, 0.52, 1)
          foreground = hsla(298.02, 0.75, 0.64, 1)
        }
      }
      state {
        hover {
          background = hsla(75.53, 0.9, 0.38, 1)
          foreground = hsla(213.04, 0.75, 0.52, 1)
        }
        pressed {
          background = hsla(350.54, 0.9, 0.64, 1)
        }
        selected {
          background = hsla(128.05, 0.75, 0.38, 1)
          foreground = hsla(265.56, 0.9, 0.52, 1)
        }
        disabled {
          background = hsla(43.07, 0.75, 0.64, 1)
