        }
      }
      form {
        input {
          background     = hsla(318.08, 0.75, 0.52, 1)
          foreground     = hsla(95.59, 0.9, 0.64, 1)
          border         = hsla(233.1, 0.75, 0.38, 1)
          invalid_border = hsla(10.61, 0.9, 0.52, 1)
          placeholder    = hsla(148.12, 0.75, 0.64, 1)
        }
      }
      focus {
        ring = hsla(285.62, 0.9, 0.38, 1)
      }
      border {
        default = hsla(63.13, 0.75, 0.52, 1)
        strong  = hsla(200.64, 0.9, 0.64, 1)
      }
      navigation {
        background          = hsla(338.15, 0.75, 0.38, 1)
        foreground          = hsla(115.66, 0.9, 0.52, 1)
        muted_foreground    = hsla(253.16, 0.75, 0.64, 1)
        hover_background    = hsla(30.67, 0.9, 0.38, 1)
        selected_background = hsla(168.18, 0.75, 0.52, 1)
        selected_foreground = hsla(305.69, 0.9, 0.64, 1)
        border              = hsla(83.2, 0.75, 0.38, 1)
      }
      data {
        positive = hsla(220.7, 0.9, 0.52, 1)
        accent_1 = hsla(358.21, 0.75, 0.64, 1)
        accent_2 = hsla(135.72, 0.9, 0.38, 1)
        accent_3 = hsla(273.23, 0.75, 0.52, 1)
        accent_4 = hsla(50.74, 0.9, 0.64, 1)
        accent_5 = hsla(188.24, 0.75, 0.38, 1)
      }
    }
    elevation {
      none = []
      drag_preview = [shadow(0.283, 2, 23, 47, -1), shadow(0.1415, 0, 22, 45, 0)]
      control = [shadow(0.296, 3, 24, 49, -2)]
      thumb = [shadow(0.309, 4, 25, 51, -3)]
      menu = [shadow(0.322, 5, 26, 53, 0), shadow(0.161, 0, 25, 51, 0)]
      popover = [shadow(0.335, 1, 27, 55, -1), shadow(0.1675, 0, 26, 53, 1)]
