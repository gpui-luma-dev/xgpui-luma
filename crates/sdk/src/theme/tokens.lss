// SDK tokens: the one neutral default theme. Layer: sdk.
//
// This file is the source of the SDK's metrics and typography: `MetricTokens::default()`,
// `LumaTypography::default()` and `ThemeTokens` read it at startup. Adding or removing a token in
// `metrics` or `typography` means changing the Rust type too; `LumaThemeMode::from_theme` rejects
// tokens that don't match.
//
// These tokens are the same in every mode; `palette.lss` holds the per-mode colors and shadows
// (light values, `mode dark` overrides). Looks map these groups onto their own data in their token files.

const {
  full_radius = 999   // FULL_RADIUS_PX: fully rounded corners

  // Motion shared by control files (MotionStylesheet::native_default()).
  default_timed = timed(200, out_cubic)
}

tokens {
  metrics {
    disabled_opacity = 0.56
    border_width     = 1

    focus {
      gap    = 1
      width  = 1
      offset = 0
    }

    // The single SDK control scale.
    control {
      height         = 36
      control_height = height   // interactive target height; defaults to height
      padding_x      = 14
      padding_y      = 8
      gap            = 8
      radius         = 6
      icon_size      = 16
    }
  }

  typography {
    const {
      body  = text(14, 20, 400)
      title = text(20, 28, 600)
    }

    font {
      sans  = "System UI"
      mono  = "Monaco"
      serif = "New York"
    }

    text {
      body    = body
      label   = text(12.5, 18, 500)
      caption = text(11, 16, 500)
      title   = title
      code    = text(13, 18, 400)

      role {
        h1 = text(44, 52, 700)
        h2 = text(28, 36, 600)
        h3 = title
        h4 = text(16, 22, 500)
        p  = body
      }
    }
  }

  // Dimensions several controls share (`SharedGeometry`, read from Rust; `label_baseline` also by `.lss`).
  geometry {
    popup_viewport_height       = 220
    popup_row_height            = 28
    menu_row_height             = 27
    menu_row_gap                = 4
    compact_textfield_height    = 22
    compact_textfield_padding_y = 2
    textarea_resize_icon_size   = 10
    textarea_resize_inset       = 3
    textarea_resize_hit_size    = 12
    textarea_scrollbar_width    = 12
    textarea_scrollbar_inset    = 2
    scrollbar_width             = 12
    composition_underline_width = 1
    label_baseline              = 1
    drag_offset                 = 12
    drag_preview_width          = 220
    drag_padding_x              = 12
    drag_padding_y              = 8
    drag_border_width           = 1
    drag_marker_width           = 2
    split_sidebar_width         = 280
    split_sidebar_min_width     = 220
    split_sidebar_max_width     = 420
    selection_scrollbar_width   = 16
    wide_middle_gap             = 24
    wide_side_min_width         = 240
    wide_side_preferred_width   = 280
    wide_middle_min_width       = 435
    wide_middle_max_width       = 435
    form_field_gap              = 4
    page_size_trigger_width     = 64
    popup_icon_size             = 16
    textarea_resize_opacity     = 0.75
  }

  motion {
    default = default_timed
  }
}
