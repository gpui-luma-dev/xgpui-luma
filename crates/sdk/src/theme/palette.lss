// SDK palette and elevation, per mode. Layer: sdk.
// The shared values are the light mode; `mode dark` overrides what differs. A mode with no block (or a
// token a mode leaves out) uses the shared value.
//
// This file is the source of the SDK's palette and shadows: `ThemeTokens::light()` / `::dark()` (and
// `LumaPalette`, `LumaElevation`) read it at startup. Adding or removing a token here means changing
// the Rust type too; `LumaThemeMode::from_theme` rejects tokens that don't match.
//
// Grays (#397): each interaction state has its own gray, evenly spaced (rest → hover → pressed), and no
// state shares a value with a border or with another state, so they stay distinguishable. Disabled is
// set apart by lightness, not hue. Only two hues: a muted blue focus ring and a muted red invalid border.

tokens {
  palette {
    app {
      background       = gray(98.04, 1)
      foreground       = gray(11.18, 1)
      muted_foreground = gray(45, 1)
    }
    shell {
      background              = gray(11, 1)
      foreground              = gray(100, 1)
      border                  = gray(100, 0.1)
      hover_background        = gray(100, 0.12)
      active_background       = gray(100, 0.2)
      close_hover_background  = gray(30, 1)
      close_active_background = gray(40, 1)
      close_foreground        = gray(100, 1)
    }
    surface {
      panel {
        background = gray(100, 1)
        foreground = gray(11.18, 1)
        border     = gray(80, 1)
      }
      floating {
        background = gray(100, 1)
        foreground = gray(11.18, 1)
        border     = gray(80, 1)
      }
      subtle {
        background = gray(96, 1)
        foreground = gray(26.67, 1)
      }
    }
    state {
      hover {
        background = gray(92, 1)
        foreground = gray(11.18, 1)
      }
      pressed  { background = gray(86, 1) }
      selected {
        background = gray(12, 1)
        foreground = gray(100, 1)
      }
      disabled {
        background = gray(94, 1)
        foreground = gray(70, 1)
      }
    }
    form {
      input {
        background     = gray(100, 1)
        foreground     = gray(11.18, 1)
        border         = gray(72, 1)
        invalid_border = srgb(0.78431, 0.27451, 0.23529, 1)
        placeholder    = gray(55, 1)
      }
    }
    focus  { ring = srgb(0.23137, 0.43529, 0.83137, 1) }
    border {
      default = gray(80, 1)
      strong  = gray(58, 1)
    }
    navigation {
      background          = gray(100, 1)
      foreground          = gray(11.18, 1)
      muted_foreground    = gray(45, 1)
      hover_background    = gray(92, 1)
      selected_background = gray(12, 1)
      selected_foreground = gray(100, 1)
      border              = gray(80, 1)
    }
    data {
      positive = gray(30, 1)
      accent_1 = gray(20, 1)
      accent_2 = gray(35, 1)
      accent_3 = gray(45, 1)
      accent_4 = gray(55, 1)
      accent_5 = gray(65, 1)
    }
  }

  // A list of layers per role; [] means no shadow.
  elevation {
    none           = []
    drag_preview   = [shadow(0.1, 0, 1, 3, 0), shadow(0.1, 0, 1, 2, -1)]
    control        = [shadow(0.05, 0, 1, 2, 0)]
    thumb          = [shadow(0.14, 0, 1, 2, 0)]
    menu           = [shadow(0.1, 0, 1, 3, 0), shadow(0.1, 0, 1, 2, -1)]
    popover        = [shadow(0.12, 0, 4, 8, -2), shadow(0.06, 0, 2, 4, -1)]
    panel          = [shadow(0.06, 0, 1, 3, 0)]
    dialog         = [shadow(0.16, 0, 18, 32, -8), shadow(0.08, 0, 6, 12, -4)]
    overlay_window = [shadow(0.2, 0, 18, 38, -16)]
  }

  // Dark mode: only the values that differ from the shared (light) ones. The shell, `data.accent_4`,
  // and the `none`, `drag_preview`, `thumb` and `overlay_window` shadows are the same in both.
  mode dark {
    palette {
      app {
        background       = gray(8.43, 1)
        foreground       = gray(98.04, 1)
        muted_foreground = gray(65.1, 1)
      }
      surface {
        panel {
          background = gray(10.98, 1)
          foreground = gray(98.04, 1)
          border     = gray(32, 1)
        }
        floating {
          background = gray(10.98, 1)
          foreground = gray(98.04, 1)
          border     = gray(32, 1)
        }
        subtle {
          background = gray(17, 1)
          foreground = gray(83.92, 1)
        }
      }
      state {
        hover {
          background = gray(22, 1)
          foreground = gray(98.04, 1)
        }
        pressed  { background = gray(28, 1) }
        selected {
          background = gray(90, 1)
          foreground = gray(10, 1)
        }
        disabled {
          background = gray(15, 1)
          foreground = gray(40, 1)
        }
      }
      form {
        input {
          background     = gray(11.18, 1)
          foreground     = gray(98.04, 1)
          border         = gray(38, 1)
          invalid_border = srgb(0.89804, 0.45098, 0.41569, 1)
          placeholder    = gray(50, 1)
        }
      }
      focus  { ring = srgb(0.41961, 0.60784, 0.94118, 1) }
      border {
        default = gray(32, 1)
        strong  = gray(55, 1)
      }
      navigation {
        background          = gray(10.98, 1)
        foreground          = gray(98.04, 1)
        muted_foreground    = gray(65.1, 1)
        hover_background    = gray(22, 1)
        selected_background = gray(90, 1)
        selected_foreground = gray(10, 1)
        border              = gray(32, 1)
      }
      data {
        positive = gray(75, 1)
        accent_1 = gray(90, 1)
        accent_2 = gray(75, 1)
        accent_3 = gray(65, 1)
        accent_5 = gray(45, 1)
      }
    }
    elevation {
      control = [shadow(0.18, 0, 1, 2, 0)]
      menu    = [shadow(0.28, 0, 1, 3, 0), shadow(0.18, 0, 1, 2, -1)]
      popover = [shadow(0.32, 0, 4, 8, -2), shadow(0.22, 0, 2, 4, -1)]
      panel   = [shadow(0.2, 0, 1, 3, 0)]
      dialog  = [shadow(0.42, 0, 18, 32, -8), shadow(0.24, 0, 6, 12, -4)]
    }
  }
}
