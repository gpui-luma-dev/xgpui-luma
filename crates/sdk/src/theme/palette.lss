// SDK palette and elevation, per mode. Layer: sdk.
// The shared values are the light mode (ThemeTokens::light()); `mode dark` overrides what differs
// (ThemeTokens::dark()). A mode with no block (or a token a mode leaves out) uses the shared value.

tokens {
  palette {
    app {
      background       = gray(98.04, 1)
      foreground       = gray(11.18, 1)
      muted_foreground = gray(46.86, 1)
    }
    shell {
      background              = gray(11, 1)
      foreground              = gray(100, 1)
      border                  = gray(100, 0.1)
      hover_background        = gray(100, 0.12)
      active_background       = gray(100, 0.2)
      close_hover_background  = gray(30, 1)
      close_active_background = gray(40, 1)
      close_foreground        = gray(100, 1)
    }
    surface {
      panel {
        background = gray(100, 1)
        foreground = gray(11.18, 1)
        border     = gray(83.92, 1)
      }
      floating {
        background = gray(100, 1)
        foreground = gray(11.18, 1)
        border     = gray(83.92, 1)
      }
      subtle {
        background = gray(96.08, 1)
        foreground = gray(26.67, 1)
      }
    }
    state {
      hover {
        background = gray(91.37, 1)
        foreground = gray(11.18, 1)
      }
      pressed  { background = gray(83.92, 1) }
      selected {
        background = gray(12, 1)
        foreground = gray(100, 1)
      }
      disabled {
        background = gray(96.08, 1)
        foreground = gray(65.1, 1)
      }
    }
    form {
      input {
        background     = gray(100, 1)
        foreground     = gray(11.18, 1)
        border         = gray(65.1, 1)
        invalid_border = gray(20, 1)
        placeholder    = gray(65.1, 1)
      }
    }
    focus  { ring = srgb(1, 0, 0, 1) }
    border {
      default = gray(83.92, 1)
      strong  = gray(46.86, 1)
    }
    navigation {
      background          = gray(100, 1)
      foreground          = gray(11.18, 1)
      muted_foreground    = gray(46.86, 1)
      hover_background    = gray(96.08, 1)
      selected_background = gray(12, 1)
      selected_foreground = gray(100, 1)
      border              = gray(83.92, 1)
    }
    data {
      positive = gray(30, 1)
      accent_1 = gray(20, 1)
      accent_2 = gray(35, 1)
      accent_3 = gray(45, 1)
      accent_4 = gray(55, 1)
      accent_5 = gray(65, 1)
    }
  }

  // A list of layers per role; [] means no shadow.
  elevation {
    none           = []
    drag_preview   = [shadow(0.1, 0, 1, 3, 0), shadow(0.1, 0, 1, 2, -1)]
    control        = [shadow(0.05, 0, 1, 2, 0)]
    thumb          = [shadow(0.14, 0, 1, 2, 0)]
    menu           = [shadow(0.1, 0, 1, 3, 0), shadow(0.1, 0, 1, 2, -1)]
    popover        = [shadow(0.12, 0, 4, 8, -2), shadow(0.06, 0, 2, 4, -1)]
    panel          = [shadow(0.06, 0, 1, 3, 0)]
    dialog         = [shadow(0.16, 0, 18, 32, -8), shadow(0.08, 0, 6, 12, -4)]
    overlay_window = [shadow(0.2, 0, 18, 38, -16)]
  }

  // Dark mode: only the values that differ from the shared (light) ones. The shell, `data.accent_4`,
  // and the `none`, `drag_preview`, `thumb` and `overlay_window` shadows are the same in both.
  mode dark {
    palette {
      app {
        background       = gray(8.43, 1)
        foreground       = gray(98.04, 1)
        muted_foreground = gray(65.1, 1)
      }
      surface {
        panel {
          background = gray(10.98, 1)
          foreground = gray(98.04, 1)
          border     = gray(26.67, 1)
        }
        floating {
          background = gray(10.98, 1)
          foreground = gray(98.04, 1)
          border     = gray(26.67, 1)
        }
        subtle {
          background = gray(17.45, 1)
          foreground = gray(83.92, 1)
        }
      }
      state {
        hover {
          background = gray(26.67, 1)
          foreground = gray(98.04, 1)
        }
        pressed  { background = gray(34.51, 1) }
        selected {
          background = gray(90, 1)
          foreground = gray(10, 1)
        }
        disabled {
          background = gray(17.45, 1)
          foreground = gray(46.86, 1)
        }
      }
      form {
        input {
          background     = gray(11.18, 1)
          foreground     = gray(98.04, 1)
          border         = gray(34.51, 1)
          invalid_border = gray(85, 1)
          placeholder    = gray(46.86, 1)
        }
      }
      focus  { ring = srgb(1, 0, 0, 1) }
      border {
        default = gray(26.67, 1)
        strong  = gray(65.1, 1)
      }
      navigation {
        background          = gray(10.98, 1)
        foreground          = gray(98.04, 1)
        muted_foreground    = gray(65.1, 1)
        hover_background    = gray(17.45, 1)
        selected_background = gray(90, 1)
        selected_foreground = gray(10, 1)
        border              = gray(26.67, 1)
      }
      data {
        positive = gray(75, 1)
        accent_1 = gray(90, 1)
        accent_2 = gray(75, 1)
        accent_3 = gray(65, 1)
        accent_5 = gray(45, 1)
      }
    }
    elevation {
      control = [shadow(0.18, 0, 1, 2, 0)]
      menu    = [shadow(0.28, 0, 1, 3, 0), shadow(0.18, 0, 1, 2, -1)]
      popover = [shadow(0.32, 0, 4, 8, -2), shadow(0.22, 0, 2, 4, -1)]
      panel   = [shadow(0.2, 0, 1, 3, 0)]
      dialog  = [shadow(0.42, 0, 18, 32, -8), shadow(0.24, 0, 6, 12, -4)]
    }
  }
}
