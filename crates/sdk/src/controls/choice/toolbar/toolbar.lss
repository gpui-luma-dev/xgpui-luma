// SDK toolbar. Layer: sdk. The shell around hosted controls, read by `styled_toolbar_look` (styled.rs). The
// shell is outlined and filled; visual variants (`ghost`) belong to the looks (#287).

/// A row of controls.
toolbar {
  /// Separator thickness and height.
  separator_width: length = exact(metrics.border_width)
  separator_height: length = exact(metrics.control.height)

  /// The shell.
  part root {
    background   = palette.surface.subtle.background
    border       = palette.border.default
    border_width = exact(metrics.border_width)
    radius       = exact(6)
    padding_x    = exact(6)
    padding_y    = exact(4)
    gap          = exact(metrics.control.gap)
    :disabled { background = palette.state.disabled.background }
  }

  /// A separator between groups of controls.
  part separator { background = palette.border.default }

}
