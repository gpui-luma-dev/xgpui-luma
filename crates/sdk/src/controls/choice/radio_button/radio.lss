// SDK radio button. Layer: sdk. Drawn by the shared choice template (controls/choice/styled.rs).

/// A round indicator with a dot, and a label.
radio {
  /// Minimum row height: the indicator plus 3px above and below (24px at the default size, the
  /// WCAG 2.2 minimum target), not the 36px button and field height, so stacked rows sit close.
  height = indicator_size + 6
  /// Space between the indicator and the label.
  gap    = metrics.control.gap
  radius = exact(metrics.control.radius)
  border_width = exact(metrics.border_width)

  /// Indicator size as a fraction of the control height.
  indicator_scale: number = 0.5
  /// Indicator diameter.
  indicator_size: length = metrics.control.control_height * indicator_scale
  /// Corner radius of the indicator: always round.
  indicator_radius: length = indicator_size
  /// Dot size as a fraction of the control height.
  dot_scale: number = 0.24
  /// Dot diameter when selected.
  dot_size: length = metrics.control.control_height * dot_scale
  /// Shift aligning the label baseline with the indicator.
  label_baseline_shift: length = exact(geometry.label_baseline)
  /// Focus ring geometry (FocusAdorner): gap to the face, stroke width, extra outward offset.
  focus_gap: length = exact(metrics.focus.gap)
  focus_width: length = exact(metrics.focus.width)
  focus_offset: length = exact(metrics.focus.offset)
  padding_x = 0
  padding_y = 0

  /// The whole control row.
  part root {
    focus_border = palette.focus.ring
    transition   = motion.default
  }

  /// The round indicator.
  part indicator {
    background = palette.form.input.background
    border     = palette.form.input.border
    :hover    { background = palette.state.hover.background }
    :pressed  { background = palette.state.pressed.background }
    :disabled { background = palette.state.disabled.background }
    :selected          { border = palette.state.selected.background }
    :selected:pressed  { border = palette.state.pressed.background }
    :selected:disabled { border = palette.form.input.border }
  }

  /// The dot.
  part dot {
    foreground = palette.app.foreground
    :selected { foreground = palette.state.selected.foreground }
    :disabled { foreground = palette.state.disabled.foreground }
  }

  /// The label text.
  part label {
    foreground  = palette.app.foreground
    font_family = typography.font.sans
    font_size   = typography.text.body.size
    line_height = font_size * typography.text.label.line_height / typography.text.label.size
    font_weight = typography.text.label.weight
    :disabled { foreground = palette.state.disabled.foreground }
  }
}
