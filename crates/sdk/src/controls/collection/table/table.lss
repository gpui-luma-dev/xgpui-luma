// SDK table. Layer: sdk. Read by `StyledTable` (styled.rs): the frame, the header row and body rows
// (`selected` is a selected row). Row padding and height come from the row scale the table lays out with;
// the drag preview's colors are the shared `drag_preview`, its geometry the `drag_*` properties.

/// Rows of data under a header.
table {
  /// Row dividers, column inset, the column resize handle (hit width, stroke, reach above and below), the
  /// header divider, and the header's bottom padding as a fraction of the vertical padding.
  row_divider_width: length = exact(1)
  column_padding_x: length = exact(12)
  column_resize_hit_width: length = exact(10)
  column_resize_line_width: length = exact(1)
  column_resize_vertical_extension: length = exact(4)
  header_divider_width: length = exact(1)
  header_padding_bottom_scale: number = 0.75
  /// Muted cells' opacity, emphasized cells' weight, and the label baseline shift.
  column_muted_opacity: number = 0.65
  column_emphasis_weight: number = typography.text.title.weight
  label_baseline_shift: length = exact(geometry.label_baseline)
  /// The row drag preview: its offset from the pointer, width, padding and border width, and the width
  /// of the insertion marker.
  drag_offset: length = exact(12)
  drag_width: length = exact(220)
  drag_padding_x: length = exact(12)
  drag_padding_y: length = exact(8)
  drag_border_width: length = exact(1)
  drag_marker_width: length = exact(2)

  /// The frame.
  part root {
    background   = palette.form.input.background
    border       = palette.form.input.border
    border_width = exact(1)
    radius       = exact(metrics.control.radius)
    padding_x    = exact(0)
    padding_y    = exact(metrics.control.padding_y / 2)
    :disabled { background = palette.state.disabled.background }
  }

  /// The header row.
  part header {
    background  = palette.surface.subtle.background
    foreground  = palette.app.muted_foreground
    font_size   = typography.text.caption.size
    line_height = typography.text.caption.line_height
    font_weight = typography.text.caption.weight
    :disabled { background = palette.state.disabled.background  foreground = palette.state.disabled.foreground }
  }

  /// A body row; its border is the divider below it.
  part row {
    background  = transparent
    foreground  = palette.app.foreground
    border      = palette.form.input.border
    radius      = exact(0)
    font_size   = typography.text.body.size
    line_height = font_size * typography.text.label.line_height / typography.text.label.size
    font_weight = typography.text.label.weight
    :hover                     { background = palette.state.hover.background }
    :pressed                   { background = palette.state.pressed.background }
    :focused                   { background = palette.surface.subtle.background }
    :hover:focused             { background = palette.surface.subtle.background }
    :pressed:focused           { background = palette.surface.subtle.background }
    :selected                  { background = palette.surface.subtle.background  foreground = palette.surface.subtle.foreground }
    :selected:hover            { background = palette.surface.subtle.background }
    :selected:pressed          { background = palette.surface.subtle.background }
    :disabled                  { background = transparent  foreground = palette.state.disabled.foreground }
    :selected:disabled         { background = transparent  foreground = palette.state.disabled.foreground }
    :focused:disabled          { background = palette.surface.subtle.background }
    :selected:focused:disabled { background = palette.surface.subtle.background }
  }
}
