// SDK sidebar. Layer: sdk. Read by `StyledSidebar` (styled.rs): section labels and navigation rows
// (`selected` is the current page). The shell layout, typography roles and drag preview are the theme's.

/// Navigation down the side of a window.
sidebar {
  /// Row icon size.
  item_icon_size: length = exact(16)
  /// A standalone sidebar frame's fill and edge (a look's sidebar container).
  container_background: color = palette.navigation.background
  container_border: color = palette.navigation.border
  /// Shell layout (`SidebarGeometry`): widths expanded, as an icon rail and on mobile; the host row height;
  /// the rail's hit width and popover offset; container and region gaps; header, footer, title and section
  /// spacing; the disclosure icon; the rail submenu's offset, edge margin, branch indicator and overhang;
  /// the engine's row, section and padding sizes; and the subtitle opacity.
  width_expanded: length = exact(256)
  width_icon_rail: length = exact(48)
  width_mobile: length = exact(288)
  item_height: length = exact(32)
  rail_hit_width: length = exact(6)
  popover_offset: length = exact(8)
  container_gap: length = exact(8)
  region_gap: length = exact(4)
  header_padding_bottom: length = exact(8)
  footer_padding_top: length = exact(8)
  title_gap: length = exact(2)
  title_padding_bottom: length = exact(4)
  section_padding_top: length = exact(8)
  disclosure_icon_size: length = exact(14)
  rail_submenu_offset_x: length = exact(12)
  window_margin: length = exact(8)
  rail_branch_indicator_size: length = exact(18)
  rail_branch_overhang: length = exact(10)
  engine_item_height: length = exact(30)
  engine_section_height: length = exact(20)
  engine_item_padding_x: length = exact(8)
  subtitle_opacity: number = 0.72

  /// A section label.
  part section {
    foreground  = palette.navigation.muted_foreground
    height      = exact(20)
    font_size   = typography.text.caption.size
    line_height = typography.text.caption.line_height
    font_weight = typography.text.caption.weight
  }

  /// A navigation row (a page, or a branch that opens more).
  part item {
    background   = transparent
    foreground   = palette.navigation.foreground
    focus_border = transparent
    radius       = exact(metrics.control.radius)
    height       = exact(30)
    padding_x    = exact(8)
    gap          = exact(metrics.control.gap)
    font_size    = typography.text.label.size
    line_height  = typography.text.label.line_height
    font_weight  = typography.text.label.weight
    :hover             { background = palette.navigation.hover_background }
    :pressed           { background = palette.state.pressed.background }
    :focused           { focus_border = palette.focus.ring }
    :selected          { background = palette.navigation.selected_background  foreground = palette.navigation.selected_foreground }
    :selected:hover    { background = palette.navigation.hover_background }
    :selected:pressed  { background = palette.state.pressed.background }
    :disabled          { background = transparent  foreground = palette.state.disabled.foreground  focus_border = transparent }
    :selected:disabled { background = transparent  foreground = palette.state.disabled.foreground }
    :focused:disabled  { focus_border = transparent }
  }
}
