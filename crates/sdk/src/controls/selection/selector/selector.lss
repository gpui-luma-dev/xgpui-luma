// SDK selector trigger. Layer: sdk. Read by the `.lss` selector theme (styled.rs); the popup panel comes
// from the selector items panel look. A trigger is a button: outline and ghost are variants (the
// trigger style picks one), so each look's own outline and ghost buttons apply.

/// The button that opens a selector's list.
selector extends button {
  /// Space between the trigger and its popup.
  menu_offset_y: length = gap / 2
  /// The chevron.
  icon: color = palette.app.muted_foreground

  part root {
    font_size   = typography.text.body.size
    line_height = font_size * typography.text.label.line_height / typography.text.label.size
  }

  variant outline {
    part root {
      background := palette.app.background
      border     := palette.border.default
      :hover            { background = palette.state.hover.background }
      :pressed          { background = palette.state.pressed.background }
      :invalid          { border = palette.form.input.invalid_border }
      :disabled         { background = palette.state.disabled.background  foreground = palette.state.disabled.foreground }
      :disabled:invalid { border = palette.border.default }
    }
  }

  variant ghost {
    part root {
      background := transparent
      border     := none
      :hover            { background = palette.state.hover.background }
      :pressed          { background = palette.state.pressed.background }
      :invalid          { border = palette.form.input.invalid_border }
      :disabled         { background = palette.state.disabled.background  foreground = palette.state.disabled.foreground }
      :disabled:invalid { border = none }
    }
  }
}
