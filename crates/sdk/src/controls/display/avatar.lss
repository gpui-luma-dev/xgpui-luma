// SDK avatar. Layer: sdk. Read by `StyledAvatar` (avatar.rs): a round image or short-text/icon fallback.
// `root` is the circle (its height is the diameter); the font size is for one letter, the declared
// two-letter size for two. Looks add variants and sizes.

/// A person or entity's picture, or its initials.
avatar {
  /// The font size for a two-letter fallback.
  two_letter_font_size: length = typography.text.label.size
  /// An icon fallback's box: Lucide glyphs fill about two thirds of it, so this matches the letters' height.
  icon_size: length = typography.text.label.size * 1.25

  part root {
    // A step darker than panels and subtle surfaces (light) or lighter (dark), so the circle shows on them.
    background  = palette.state.pressed.background
    foreground  = palette.app.foreground
    height      = exact(40)
    radius      = exact(999)
    font_family = typography.font.sans
    font_size   = typography.text.label.size
    line_height = font_size
    font_weight = 500
  }
}
