// Radix tree view. Layer: look. Gray 12 rows with gray 9 icons; the selected node an accent 3 tint with
// accent 12 text and icons; a focused row accent 4, a pressed one accent 5; hovering draws an accent 8 inset
// outline instead of a fill; gray 11 when disabled. Sizes 1–3.

tree_view {
  icon_size    = 14
  chevron_size = 12
  icon_color   = gray[9]
  size 1 { icon_size = 12  chevron_size = 10 }
  size 3 { icon_size = 16  chevron_size = 14 }

  part root {
    foreground  = gray[12]
    height      = 27
    padding_x   = 12
    gap         = 8
    radius      = exact(4)
    font_family = look.font_sans
    font_size   = 14
    line_height = 20
    font_weight = 400
    :hover             { background = transparent  outline = accent[8] }
    :focused           { background = accent[4] }
    :pressed           { background = accent[5] }
    :pressed:focused   { background = accent[5] }
    :selected          { background = accent[3]  foreground = accent[12]  icon_color = accent[12] }
    :selected:hover    { background = accent[3] }
    :selected:focused  { background = accent[3] }
    :selected:pressed  { background = accent[5] }
    :disabled          { background = transparent  foreground = gray[11]  icon_color = gray[9]  outline = transparent }
    :selected:disabled { background = transparent  foreground = gray[11]  icon_color = gray[9] }
  }
  size 1 { part root { height = 20  padding_x = 8   gap = 4   radius = exact(3)  font_size = 12.5  line_height = 18 } }
  size 3 { part root { height = 34  padding_x = 16  gap = 12  radius = exact(6)  font_size = 16    line_height = 22 } }
}
