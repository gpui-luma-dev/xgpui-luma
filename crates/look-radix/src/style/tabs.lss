// Radix tabs. Layer: look. Line (the base): no list box, muted labels that take the foreground when active
// or hovered, a gray ghost fill when hovered or pressed, and a primary underline on the active tab. Surface:
// a padded gray 3 list with the active tab as a background-colored chip and no underline. Sizes 1–3.

tabs {
  indicator_height = exact(2)
  // The line tabs' full-width baseline (`TabsStyle` can retune or hide it) and inset label padding.
  baseline_color    = gray[5]
  baseline_height   = exact(1)
  content_padding_x = exact(8)
  content_padding_y = exact(4)
  size 1 { content_padding_x = exact(4)  content_padding_y = exact(2) }

  part root {
    :selected                  { indicator = radix.role.primary }
    :selected:pressed          { indicator = radix.role.primary }
    :selected:focused          { indicator = radix.role.primary }
    :selected:pressed:focused  { indicator = radix.role.primary }
    :selected:disabled         { indicator = radix.role.primary }
    :selected:focused:disabled { indicator = radix.role.primary }
  }

  part list {
    background = transparent
    radius     = exact(0)
    padding    = exact(0)
    gap        = exact(0)
    :disabled { background = radix.role.surface }
  }

  part item {
    background  = transparent
    foreground  = radix.role.muted_foreground
    radius      = exact(4)
    padding_x   = exact(16)
    height      = exact(40)
    font_size   = 14
    line_height = 20
    font_weight = 400
    :hover             { foreground = radix.role.foreground  background = gray[3] }
    :pressed           { background = gray[4] }
    :selected          { foreground = radix.role.foreground  font_weight = 500 }
    :selected:pressed  { foreground = radix.role.foreground }
    :disabled          { foreground = radix.role.muted_foreground  background = transparent }
    :selected:disabled { foreground = radix.role.muted_foreground  background = transparent }
  }
  size 1 { part item { radius = exact(3)  padding_x = exact(8)  height = exact(32)  font_size = 12  line_height = 16 } }
  size 3 { part item { radius = exact(6) } }

  variant surface {
    indicator_height = exact(0)
    part root {
      :selected                  { indicator = transparent }
      :selected:pressed          { indicator = transparent }
      :selected:focused          { indicator = transparent }
      :selected:pressed:focused  { indicator = transparent }
      :selected:disabled         { indicator = transparent }
      :selected:focused:disabled { indicator = transparent }
    }
    part list {
      background := gray[3]
      radius      = exact(4)
      padding     = exact(4)
      gap         = exact(2)
      :disabled { background = gray[3] }
    }
    part item {
      :selected          { background = radix.role.background }
      :selected:hover    { background = radix.role.background }
      :selected:pressed  { background = radix.role.background }
      :selected:disabled { background = radix.role.background }
    }
    size 1 { part list { radius = exact(3) } }
    size 3 { part list { radius = exact(6) } }
  }
}
