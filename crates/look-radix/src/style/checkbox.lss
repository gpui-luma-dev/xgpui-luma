// Radix checkbox. Layer: look, over the SDK checkbox. Replaces CheckboxThemeAdapter, checkbox_scale_for
// and the Radix checkbox geometry; `style::tests::checkbox_matches_the_native_look` checks it for every
// variant, size, radius, tone, high contrast, state and mode.
// Geometry matches `@radix-ui/themes` BaseCheckbox at `--scaling: 1`. Lengths are `exact`: native Radix
// geometry is not snapped to device pixels.
// The base is the surface variant at size 2. Colors own their property (`:=`) against the SDK; press
// keeps the resting fill, only hover changes the checked fill.

checkbox {
  gap              = exact(8)
  indicator_size   = exact(16)   // --checkbox-size
  glyph_size       = exact(10)   // --checkbox-indicator-size
  // Never a pill: radius full uses the large factor.
  indicator_radius = exact(radix.radius_1 * radix.checkbox_radius_scale * radix.radius_factor)
  height           = exact(indicator_size)
  radius           = exact(indicator_radius)
  label_baseline_shift = 0

  size 1 { indicator_size = exact(14)  glyph_size = exact(9) }
  size 3 { indicator_size = exact(20)  glyph_size = exact(12) }

  part root { focus_border = radix.role.focus }

  part indicator {
    background := radix.role.surface
    border     := gray[7]
    shadow     := []
    :checked                 { background = radix.role.primary  border = background }
    :checked:hover           { background = tone[10] }
    :checked:high_contrast   { background = tone[12] }
    :checked:high_contrast:hover { background = tone[12] }
    :disabled                { background = alpha(radix.role.surface, 0)  border = gray[6] }
    :checked:high_contrast:disabled { background = alpha(radix.role.surface, 0) }
  }

  part glyph {
    foreground := gray[11]
    :checked               { foreground = radix.role.primary_foreground }
    :checked:high_contrast { foreground = tone[1] }
    :disabled              { foreground = gray[8] }
    :checked:high_contrast:disabled { foreground = gray[8] }
  }

  part label {
    foreground := radix.role.foreground
    font_size   = 14
    line_height = 20
    font_weight = 400
    :disabled { foreground = radix.role.muted_foreground }
  }
  size 1 { part label { font_size = 12.5  line_height = 18 } }
  size 3 { part label { font_size = 16    line_height = 22 } }

  // Classic: a raised face. Radix `--shadow-1` at rest; on the checked face a light rim on top and a
  // dark one underneath stand in for Radix's gradient.
  variant classic {
    part indicator {
      border = gray[3]
      shadow = [inset_shadow(gray[5], 0, 0, 0, 1), inset_shadow(alpha(gray[2], 0.5), 0, 1.5, 2, 0)]
      :checked  { shadow = [inset_shadow(alpha(glyph.foreground, 0.35), 0, 0.5, 0.5, 0),
                            inset_shadow(alpha(black, 0.28), 0, -0.5, 0.5, 0)] }
      :disabled { shadow = [inset_shadow(gray[5], 0, 0, 0, 1), inset_shadow(alpha(gray[3], 0.4), 0, 1.5, 2, 0)] }
    }
  }

  // Soft: one tint whether or not it is checked, and no edge when disabled.
  variant soft {
    part indicator {
      background := tone[5]
      border     := tone[5]
      :disabled { background = alpha(radix.role.surface, 0)  border = alpha(radix.role.surface, 0) }
    }
    part glyph {
      foreground := tone[11]
      :high_contrast { foreground = tone[12] }
      :disabled      { foreground = gray[8] }
    }
  }
}
