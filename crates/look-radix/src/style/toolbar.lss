// Radix toolbar. Layer: look. A gray 1 shell (gray 2 disabled) with gray 6 edges and separators, compact
// padding, and separators 65% of the control height. Sizes 1–3.

toolbar {
  separator_height = exact(20.8)
  size 1 { separator_height = exact(15.6) }
  size 3 { separator_height = exact(26) }

  part root {
    background = gray[1]
    border     = gray[6]
    radius     = exact(4)
    padding_x  = exact(4)
    padding_y  = exact(3)
    gap        = exact(6)
    :disabled { background = gray[2] }
  }
  part separator { background = gray[6] }
}
