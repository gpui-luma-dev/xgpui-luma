// Radix table. Layer: look. The surface frame with the border role (the focus role while focused), a gray 3
// header, rows that tint gray 3 hovered and gray 4 pressed, selected rows accent 3–5 with accent 11 text, a
// focused row accent 2; muted when disabled. Sizes 1–3.

table {
  label_baseline_shift = exact(1)
  size 1 { label_baseline_shift = exact(0.5) }
  size 3 { label_baseline_shift = exact(1.5) }

  part root {
    background = radix.role.surface
    border     = radix.role.border
    radius     = exact(radix.button_radius_base * radix.radius_factor)
    padding_y  = exact(0)
    :focused  { border = radix.role.focus }
    :disabled { background = radix.role.surface }
  }

  part header {
    background = gray[3]
    foreground = radix.role.foreground
    :disabled { background = gray[3]  foreground = radix.role.muted_foreground }
  }

  part row {
    foreground  = radix.role.foreground
    border      = radix.role.border
    font_size   = 14
    line_height = 20
    font_weight = 400
    :hover                     { background = gray[3] }
    :pressed                   { background = gray[4] }
    :focused                   { background = accent[2] }
    :hover:focused             { background = gray[3] }
    :pressed:focused           { background = gray[4] }
    :selected                  { background = accent[3]  foreground = accent[11] }
    :selected:hover            { background = accent[4] }
    :selected:pressed          { background = accent[5] }
    :disabled                  { background = transparent  foreground = radix.role.muted_foreground }
    :selected:disabled         { background = transparent  foreground = radix.role.muted_foreground }
    :focused:disabled          { background = transparent }
    :selected:focused:disabled { background = transparent }
  }
  size 1 { part row { font_size = 12.5  line_height = 18 } }
  size 3 { part row { font_size = 16    line_height = 22 } }
}
