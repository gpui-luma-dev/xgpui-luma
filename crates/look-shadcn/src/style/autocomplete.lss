// Shadcn autocomplete. Layer: look. A primary status mark, muted text and clear button, the foreground
// when the clear button is hovered, and small status text.

autocomplete {
  part root {
    status           = css.primary
    muted_text       = css.muted_foreground
    clear_icon       = css.muted_foreground
    clear_icon_hover = css.foreground
    font_size        = 12.5
    line_height      = 18
    font_weight      = 400
  }
}
