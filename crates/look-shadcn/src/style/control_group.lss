// Shadcn control group. Layer: look. A muted frame with the border edge; muted-foreground when disabled.
// A disabled default row fades over its resting colors.

control_group {
  part root {
    background = css.muted
    border     = css.border
    :disabled { background = css.muted_foreground }
  }

  part item {
    :disabled { opacity = 0.56 }
  }
}
