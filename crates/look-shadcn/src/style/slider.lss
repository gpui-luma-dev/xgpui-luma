// Shadcn slider. Layer: look. A border-colored track, the primary range (its hover and pressed layers) and
// a primary-ringed thumb with `shadow-sm`; secondary uses the secondary foreground. Sizes sm, md, lg.

slider {
  // Corner radius presets for the track and thumb ends: a corner never exceeds half the part, so medium,
  // large and full are all pills.
  radius none   { part track { radius = exact(0) }  part thumb { radius = exact(0) } }
  radius small  {
    part track { radius = exact(min(shadcn.radius_small, track_height / 2)) }
    part thumb { radius = exact(min(shadcn.radius_small, thumb_size / 2)) }
  }
  radius medium { part track { radius = exact(track_height / 2) }  part thumb { radius = exact(thumb_size / 2) } }
  radius large  { part track { radius = exact(track_height / 2) }  part thumb { radius = exact(thumb_size / 2) } }
  radius full   { part track { radius = exact(track_height / 2) }  part thumb { radius = exact(thumb_size / 2) } }

  track_height = exact(6)
  thumb_size   = exact(16)
  size sm { track_height = exact(4)  thumb_size = exact(12) }
  size lg { track_height = exact(8)  thumb_size = exact(20) }

  part root { height = exact(32) }
  size sm { part root { height = exact(24) } }
  size lg { part root { height = exact(40) } }

  // No track outline (the SDK draws one); set a width here to give the shadcn track a border.
  part track {
    background = css.border
    border_width = exact(0)
    :disabled { background = css.border }
  }

  part fill {
    background = css.primary
    :hover    { background = css.primary_hover }
    :pressed  { background = css.primary_pressed }
    :disabled { background = css.muted_foreground }
  }

  part thumb {
    background = first(css.background, css.card)
    border     = css.primary
    shadow     = first(css.shadow_sm, [])
    :disabled { background = first(css.background, css.card)  border = css.muted  shadow = [] }
  }

  variant secondary {
    part fill {
      background := css.secondary_foreground
      :disabled { background = css.muted_foreground }
    }
    part thumb {
      border := css.secondary_foreground
      :disabled { border = css.muted }
    }
  }
}
