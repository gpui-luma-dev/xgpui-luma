// Shadcn context-menu target. Layer: look. No fill; the text takes the accent foreground while hovered
// or pressed. Disabled, the target fades over its resting colors.

context_menu {
  part root {
    background := transparent
    foreground := css.foreground
    border     = css.border
    :hover    { background = transparent  foreground = first(css.accent_foreground, css.foreground) }
    :pressed  { background = transparent  foreground = first(css.accent_foreground, css.foreground) }
    :disabled { opacity = 0.56 }
  }
}
