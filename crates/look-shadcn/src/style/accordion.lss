// Shadcn accordion. Layer: look. Triggers fill with the accent and take the accent foreground (chevron too)
// while hovered or pressed; muted when disabled. Sizes sm, md, lg from the control metrics.

accordion {
  part root {
    foreground         = css.foreground
    border             = css.border
    chevron            = css.muted_foreground
    content_foreground = css.foreground
    :hover    { background = css.accent  foreground = css.accent_foreground  chevron = css.accent_foreground }
    :pressed  { background = css.accent  foreground = css.accent_foreground  chevron = css.accent_foreground }
    :disabled { background = transparent  foreground = css.muted_foreground  chevron = css.muted_foreground }
  }
}
