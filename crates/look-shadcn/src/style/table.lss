// Shadcn table. Layer: look. The background frame with the border edge, a muted header with muted text,
// rows in the foreground that wash with the accent under the pointer, and selected or focused rows on the
// muted fill; a disabled row fades over its resting colors. Row text at the control font size.

table {
  part root {
    background = css.background
    border     = css.border
    :disabled { background = css.muted }
  }

  part header {
    background = css.muted
    foreground = css.muted_foreground
    :disabled { background = css.muted  foreground = css.muted_foreground }
  }

  part row {
    foreground  = css.foreground
    border      = css.border
    font_size   = shadcn.control_font_size
    line_height = font_size * typography.text.label.line_height / typography.text.label.size
    :hover                     { background = alpha(css.accent, 0.4) }
    :pressed                   { background = alpha(css.accent_pressed, 0.4) }
    :focused                   { background = css.muted }
    :hover:focused             { background = css.muted }
    :pressed:focused           { background = css.muted }
    :selected                  { background = css.muted  foreground = css.foreground }
    :selected:hover            { background = css.muted }
    :selected:pressed          { background = css.muted }
    :disabled                  { background = transparent  foreground = css.foreground  opacity = 0.56 }
    :selected:disabled         { background = css.muted  foreground = css.foreground }
    :focused:disabled          { background = css.muted }
    :selected:focused:disabled { background = css.muted }
  }
}
