// Shadcn tree view. Layer: look. Rows and icons in the foreground; the accent's hover and pressed layers
// under the pointer; the selected node in the primary colors; muted when disabled. Row text at the control
// font size.

tree_view {
  icon_color = css.foreground

  part root {
    foreground  = css.foreground
    font_size   = shadcn.control_font_size
    line_height = font_size * typography.text.label.line_height / typography.text.label.size
    :hover             { background = css.accent_hover }
    :pressed           { background = css.accent_pressed }
    :selected          { background = css.primary  foreground = css.primary_foreground  icon_color = css.primary_foreground }
    :selected:hover    { background = css.primary }
    :selected:pressed  { background = css.primary }
    :disabled          { background = transparent  foreground = css.muted_foreground  icon_color = css.muted_foreground }
    :selected:disabled { background = transparent  foreground = css.muted_foreground  icon_color = css.muted_foreground }
  }
}
