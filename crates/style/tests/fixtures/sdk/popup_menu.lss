// SDK popup menu (converted from #94 popup_menu/style.hcl; its SDK variants are dropped and its
// `motion { }` block becomes part transitions). Layer: sdk.

/// A trigger button and the menu it opens.
popup_menu {
  height      = metrics.control.control_height
  padding_x   = metrics.control.padding_x
  gap         = metrics.control.gap
  radius      = exact(metrics.control.radius)
  font_size   = typography.text.label.size
  line_height = typography.text.label.line_height
  /// Gap between the trigger and the menu.
  menu_offset_y: length = gap * 0.5

  /// The button that opens the menu.
  part trigger {
    background   = palette.surface.subtle.background
    foreground   = palette.app.foreground
    border       = palette.border.default
    shadow       = elevation.control
    focus_border = palette.focus.ring
    :hover    { background = palette.state.hover.background }
    :pressed  { background = palette.state.pressed.background }
    :disabled { background = palette.state.disabled.background  foreground = palette.state.disabled.foreground }
  }

  /// The menu panel. Its transition is the menu's presence: timed in, instant out.
  part menu {
    background = palette.surface.floating.background
    border     = palette.surface.floating.border
    shadow     = elevation.menu
    transition = instant
    :open { transition = motion.default }
  }

  /// The highlight that moves to the hovered item.
  part highlight {
    background = palette.state.hover.background
    transition = motion.highlight
  }

  /// The disclosure chevron.
  part chevron {
    foreground = palette.app.muted_foreground
    transition = motion.default
  }
}
